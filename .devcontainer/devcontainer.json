{
  // Cloudflare OS Workshop devcontainer.
  //
  // Purpose: give an attendee a disposable environment whose Wrangler credential store is
  // EMPTY. The workshop provisions a temporary event account, and `bootstrap.js` refuses to
  // run when any other Wrangler credential is visible (see
  // `scripts/temporary-account.ts:conflictingCredentialSources`). On a normal laptop an
  // existing `wrangler login` therefore blocks the workshop, and the alternative -- running
  // `wrangler logout` -- would destroy the attendee's real credentials. A container is the
  // "separate OS user/profile" that TROUBLESHOOTING.md sections 3 and 4 ask for.
  //
  // Nothing from the host's `~/.wrangler`, `~/.config/.wrangler`, CLOUDFLARE_API_TOKEN, or
  // CLOUDFLARE_API_KEY reaches this container: neither the host home directory nor arbitrary
  // host environment variables are forwarded by Dev Containers, and this definition adds no
  // credential mount, `remoteEnv`, or `containerEnv` entry.
  "name": "Cloudflare OS Workshop",

  // Node 24 LTS: package.json requires >=24.19.0, and the image's Node ships Corepack, which
  // Node 25+ removed. Pinned to the Debian release rather than floating `:24` so every
  // attendee at the event resolves the same base layer.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-trixie",

  "features": {
    // The base image has git, but this keeps the attendee's clone tool current.
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // The deploy flow is `pnpm deploy` against the temporary account's API token -- it never
  // opens a browser. But `wrangler login` is a footgun here (it clears the temporary cache,
  // per TROUBLESHOOTING.md section 3), so its localhost:8976 callback port is deliberately
  // NOT forwarded. Only the local dev server ports are.
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": { "label": "Vite dev server (pnpm --dir cloudflare-os dev-client)" },
    "8787": { "label": "Wrangler dev (pnpm --dir cloudflare-os dev-server)" }
  },

  "containerEnv": {
    // Keep pnpm's store inside the container so it is never shared with the host's store.
    "PNPM_HOME": "/home/node/.local/share/pnpm"
  },

  "remoteUser": "node",

  // Activates the pinned pnpm version only. Installs remain an explicit, interactive attendee
  // step: pnpm may need confirmation before replacing an existing host-platform node_modules.
  "onCreateCommand": "bash .devcontainer/post-create.sh",

  // Prints the attendee's next step and re-verifies the environment on every container start,
  // including after a rebuild.
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        // Lint and format: the repo drives oxlint through Vite+ (`vp lint`), so the Oxc
        // extension matches what `pnpm lint:check` enforces.
        "oxc.oxc-vscode",
        // JSONC with comments: deployment.jsonc, deployment.template.jsonc and every
        // wrangler.jsonc rely on comments and trailing commas.
        "editorconfig.editorconfig"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // deployment.jsonc is generated by bootstrap.js and read back by the deploy scripts
        // with jsonc-parser. Treating .jsonc as JSON-with-comments stops the editor flagging
        // the annotated template as invalid.
        "files.associations": {
          "*.jsonc": "jsonc",
          "deployment.jsonc": "jsonc"
        },
        "files.eol": "\n"
        // No "typescript.tsdk": the workspace `typescript` is 7.0.2 (tsgo), whose lib/ has no
        // tsserver.js -- pointing VS Code at it breaks IntelliSense outright. The repo type-
        // checks with `pnpm build`; the editor stays on its own bundled TypeScript.
      }
    }
  }
}
